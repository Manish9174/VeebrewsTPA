{%- comment -%}
  Section: About – EPIC (Outline text + values + jobs)
  File name: sections/about-epic.liquid
{%- endcomment -%}

{%- liquid
  assign sid = section.id
-%}

<style>
  #ae-{{ sid }} {
    --ae-bg: {{ section.settings.bg_color }};
    --ae-outline: {{ section.settings.outline_color }};
    --ae-heading: {{ section.settings.heading_color }};
    --ae-text: {{ section.settings.text_color }};
    --ae-link: {{ section.settings.link_color }};
    --ae-icon-bg: {{ section.settings.icon_bg }};
    --ae-job-bg: {{ section.settings.job_bg }};
    --ae-job-alt: {{ section.settings.job_alt_bg }};
    --ae-job-text: {{ section.settings.job_text_color }};
    --ae-job-loc: {{ section.settings.job_location_color }};
    background: var(--ae-bg);
    color: var(--ae-text);
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    font-family: 'Lineal', 'Rubik', sans-serif;
    box-sizing: border-box;
    overflow: hidden;
  }

  #ae-{{ sid }} *,
  #ae-{{ sid }} *::before,
  #ae-{{ sid }} *::after { box-sizing: border-box; }

  #ae-{{ sid }} .ae__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Big outlined word */
  #ae-{{ sid }} .ae__big {
    margin: 0;
    font-size: clamp(110px, 31vw, {{ section.settings.big_size }}px);
    line-height: .9;
    font-weight: {{ section.settings.big_weight }};
    letter-spacing: {{ section.settings.big_spacing }}px;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: {{ section.settings.stroke_width }}px var(--ae-outline);
    paint-order: stroke fill;
    user-select: none;
    white-space: nowrap;
  }

  #ae-{{ sid }} .ae__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px {{ section.settings.col_gap }}px;
    margin-top: {{ section.settings.cols_top_gap }}px;
    align-items: start;
  }

  #ae-{{ sid }} .ae__heading {
    margin: 0;
    font-size: 30px;
    line-height: 1.3;
    font-weight: 300;
    color: var(--ae-heading);
  }

  #ae-{{ sid }} .ae__body {
    margin-top: 28px;
    font-size: 15px;
    line-height: 1.7;
    font-weight: 400;
  }

  #ae-{{ sid }} .ae__body p { margin: 0 0 1.5em; }
  #ae-{{ sid }} .ae__body p:last-child { margin-bottom: 0; }
  #ae-{{ sid }} .ae__body a { color: var(--ae-link); text-decoration: underline; }
  #ae-{{ sid }} .ae__body a:hover { opacity: .8; }
  #ae-{{ sid }} .ae__body strong,
  #ae-{{ sid }} .ae__body b { font-weight: 700; }

  /* Links list */
  #ae-{{ sid }} .ae__links {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #ae-{{ sid }} .ae__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ae-link);
    font-size: 15px;
    text-decoration: none;
  }

  #ae-{{ sid }} .ae__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 5px;
    background: var(--ae-icon-bg);
    color: var(--ae-link);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .3px;
  }

  #ae-{{ sid }} .ae__link-text {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #ae-{{ sid }} .ae__link svg {
    width: 8px;
    height: 8px;
    margin-left: -6px;
    margin-top: -4px;
    flex: 0 0 auto;
    transition: transform .2s ease;
  }

  #ae-{{ sid }} .ae__link:hover .ae__link-text { opacity: .8; }
  #ae-{{ sid }} .ae__link:hover svg { transform: translate(1px, -1px); }
  #ae-{{ sid }} .ae__link:focus-visible,
  #ae-{{ sid }} .ae__job:focus-visible { outline: 2px solid var(--ae-link); outline-offset: 3px; }

  /* Jobs list */
  #ae-{{ sid }} .ae__jobs {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    border-radius: 6px;
    overflow: hidden;
  }

  #ae-{{ sid }} .ae__jobs li:nth-child(odd) .ae__job { background: var(--ae-job-bg); }
  #ae-{{ sid }} .ae__jobs li:nth-child(even) .ae__job { background: var(--ae-job-alt); }

  #ae-{{ sid }} .ae__job {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 10px;
    color: var(--ae-job-text);
    text-decoration: none;
    font-size: 12px;
    transition: filter .2s ease;
  }

  #ae-{{ sid }} a.ae__job:hover { filter: brightness(1.25); }

  #ae-{{ sid }} .ae__job-title { font-weight: 700; }

  #ae-{{ sid }} .ae__job-loc {
    flex: 0 0 auto;
    font-size: 11px;
    font-weight: 400;
    color: var(--ae-job-loc);
    white-space: nowrap;
  }

  #ae-{{ sid }} .ae__after { margin-top: 24px; }

  @media (prefers-reduced-motion: reduce) {
    #ae-{{ sid }} .ae__link svg,
    #ae-{{ sid }} .ae__job { transition: none; }
  }

  /* Laptop */
  @media (max-width: 1199px) {
    #ae-{{ sid }} .ae__heading { font-size: 27px; }
  }

  /* Tablet & Mobile: stack */
  @media (max-width: 849px) {
    #ae-{{ sid }} {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }
    #ae-{{ sid }} .ae__cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 50px;
      margin-top: {{ section.settings.cols_top_gap | times: 0.7 | round }}px;
    }
    #ae-{{ sid }} .ae__heading { font-size: 26px; }
  }

  @media (max-width: 599px) {
    #ae-{{ sid }} {
      padding-left: 18px;
      padding-right: 18px;
      padding-top: {{ section.settings.padding_top | times: 0.5 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round }}px;
    }
    #ae-{{ sid }} .ae__big { -webkit-text-stroke-width: {{ section.settings.stroke_width | times: 0.7 }}px; }
    #ae-{{ sid }} .ae__heading { font-size: 23px; }
    #ae-{{ sid }} .ae__body { margin-top: 20px; font-size: 14px; }
    #ae-{{ sid }} .ae__job { font-size: 12px; padding: 12px 10px; }
  }
</style>

<section id="ae-{{ sid }}" class="ae" data-section-id="{{ sid }}">
  <div class="ae__inner">

    {%- if section.settings.big_text != blank -%}
      <p class="ae__big" aria-hidden="true">{{ section.settings.big_text | escape }}</p>
      <span class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;">{{ section.settings.big_text | escape }}</span>
    {%- endif -%}

    <div class="ae__cols">

      {%- comment -%} LEFT COLUMN {%- endcomment -%}
      <div class="ae__col">
        {%- if section.settings.left_heading != blank -%}
          <h2 class="ae__heading">{{ section.settings.left_heading | newline_to_br }}</h2>
        {%- endif -%}

        {%- if section.settings.left_text != blank -%}
          <div class="ae__body">{{ section.settings.left_text }}</div>
        {%- endif -%}

        {%- assign has_links = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'link' -%}{%- assign has_links = true -%}{%- endif -%}
        {%- endfor -%}

        {%- if has_links -%}
          <ul class="ae__links">
            {%- for block in section.blocks -%}
              {%- if block.type == 'link' -%}
                <li {{ block.shopify_attributes }}>
                  <a class="ae__link" href="{{ block.settings.url | default: '#' }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>
                    {%- if block.settings.icon_text != blank -%}
                      <span class="ae__icon" aria-hidden="true">{{ block.settings.icon_text }}</span>
                    {%- endif -%}
                    <span class="ae__link-text">{{ block.settings.label }}</span>
                    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 10L10 2M4 2h6v6"/></svg>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} RIGHT COLUMN {%- endcomment -%}
      <div class="ae__col">
        {%- if section.settings.right_heading != blank -%}
          <h2 class="ae__heading">{{ section.settings.right_heading | newline_to_br }}</h2>
        {%- endif -%}

        {%- assign has_jobs = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'job' -%}{%- assign has_jobs = true -%}{%- endif -%}
        {%- endfor -%}

        {%- if has_jobs -%}
          <ul class="ae__jobs">
            {%- for block in section.blocks -%}
              {%- if block.type == 'job' -%}
                <li {{ block.shopify_attributes }}>
                  {%- if block.settings.url != blank -%}
                    <a class="ae__job" href="{{ block.settings.url }}">
                  {%- else -%}
                    <div class="ae__job">
                  {%- endif -%}
                      <span class="ae__job-title">{{ block.settings.title }}</span>
                      <span class="ae__job-loc">{{ block.settings.location }}</span>
                  {%- if block.settings.url != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.right_text != blank -%}
          <div class="ae__body ae__after">{{ section.settings.right_text }}</div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About – EPIC",
  "tag": "section",
  "class": "section-about-epic",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Big outlined text"
    },
