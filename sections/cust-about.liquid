{%- comment -%}
  Section: About – Simply Great Coffee (Founders)
  File name: sections/about-founders.liquid
{%- endcomment -%}



{%- liquid
  assign sid = section.id
-%}

<style>
  #af-{{ sid }} {
    --af-top: {{ section.settings.top_bg }};
    --af-bottom: {{ section.settings.bottom_bg }};
    --af-text: {{ section.settings.text_color }};
    --af-eyebrow: {{ section.settings.eyebrow_color }};
    --af-heading: {{ section.settings.heading_color }};
    --af-founder: {{ section.settings.founder_color }};
    --af-split: {{ section.settings.split }}%;
    background: var(--af-bottom);
    color: var(--af-text);
    font-family: 'Rubik', sans-serif;
    overflow: hidden;
  }

  #af-{{ sid }} .af__hero {
    background: linear-gradient(to bottom, var(--af-top) 0, var(--af-top) var(--af-split), var(--af-bottom) var(--af-split), var(--af-bottom) 100%);
    padding-top: {{ section.settings.padding_top }}rem;
    text-align: center;
  }

  #af-{{ sid }} .af__arc {
    display: block;
    width: 100%;
    max-width: {{ section.settings.heading_width | default: 800 }}px;
        height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  #af-{{ sid }} .af__eyebrow {
    font-family: 'Lineal';
    font-weight: 500;
    font-size: 22px;
    letter-spacing: 2px;
    text-transform: uppercase;
    fill: var(--af-eyebrow);
  }

  #af-{{ sid }} .af__title {
    font-family: 'Lineal';
    font-style: italic;
    font-weight: 700;
    font-size: 58px;
    fill: var(--af-heading);
  }

  #af-{{ sid }} .af__image-wrap {
    max-width: {{ section.settings.image_max_width }}px;
    margin: -10px auto 0;
    padding: 0 20px;
  }

  #af-{{ sid }} .af__image-wrap img,
  #af-{{ sid }} .af__image-wrap svg {
    display: block;
    width: 100%;
    height: auto;
  }

  #af-{{ sid }} .af__content {
    max-width: 560px;
    margin: 0 auto;
    padding: 30px 20px {{ section.settings.padding_bottom }}px;
    text-align: center;
  }

  #af-{{ sid }} .af__text {
    font-size: 22px;
    line-height: 1.8;
    font-weight: 400;
    margin: 0;
    font-family: 'Lineal';
  }

  #af-{{ sid }} .af__text p { margin: 0; }

  #af-{{ sid }} .af__founders {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 40px 70px;
    margin-top: 55px;
    padding: 0;
    list-style: none;
      font-family: 'Lineal';
  }

  #af-{{ sid }} .af__founder {
    width: 140px;
    text-align: center;
    color: var(--af-founder);
      font-family: 'Lineal';
  }

  {% if section.settings.stagger %}
  @media (min-width: 750px) {
    #af-{{ sid }} .af__founder:nth-child(even) { margin-top: 30px; }
  }
  {% endif %}

  #af-{{ sid }} .af__avatar {
    width: 110px;
    height: 110px;
    margin: 0 auto 14px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 6px 16px rgba(30, 45, 110, .25);
    background: #fff;

  }

  #af-{{ sid }} .af__avatar img,
  #af-{{ sid }} .af__avatar svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #af-{{ sid }} .af__name {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .3px;
    text-transform: uppercase;
      font-family: 'Lineal';
  }

  #af-{{ sid }} .af__role {
    margin: 4px 0 0;
    font-size: 14px;
    font-style: italic;
    font-weight: 400;
      font-family: 'Lineal';
  }

  /* Tablet */
  @media (max-width: 989px) {
    #af-{{ sid }} .af__text { font-size: 20px; }
    #af-{{ sid }} .af__founders { gap: 35px 45px; }
  }

  /* Mobile */
  @media (max-width: 749px) {
    #af-{{ sid }} .af__hero { 
      
      padding-top: 12rem; 
    
    }
    #af-{{ sid }} .af__arc { max-width: 100%; padding: 0 10px; box-sizing: border-box; }
    #af-{{ sid }} .af__image-wrap { padding: 0 8px; margin-top: 0; }
    #af-{{ sid }} .af__content { padding: 20px 20px {{ section.settings.padding_bottom | times: 0.7 | round }}px; }
    #af-{{ sid }} .af__text { font-size: 17px; line-height: 1.7; }
    #af-{{ sid }} .af__founders { gap: 24px 18px; margin-top: 36px; flex-wrap: nowrap; }
    #af-{{ sid }} .af__founder { width: 30%; max-width: 110px; }
    #af-{{ sid }} .af__avatar { width: 74px; height: 74px; margin-bottom: 10px; }
    #af-{{ sid }} .af__name { font-size: 11px; }
    #af-{{ sid }} .af__role { font-size: 11px; }
  }


     .af__image-wrap img {
  animation: floatingProduct 2s ease-in-out infinite;
}

@keyframes floatingProduct {
  0% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-1.7rem);
  }

  100% {
    transform: translateY(0);
  }
} 
</style>

<section id="af-{{ sid }}" class="af" data-section-id="{{ sid }}">
  <div class="af__hero">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <svg class="af__arc" viewBox="0 0 800 220" role="img" aria-label="{{ section.settings.eyebrow | escape }} {{ section.settings.heading | escape }}">
        <defs>
          <path id="af-eyebrow-path-{{ sid }}" d="M 240 55 Q 400 28 560 55" fill="none"/>
<path id="af-title-path-{{ sid }}" d="M 20 195 Q 400 60 780 195" fill="none"/>
        </defs>
        {%- if section.settings.eyebrow != blank -%}
          <text class="af__eyebrow" text-anchor="middle">
            <textPath href="#af-eyebrow-path-{{ sid }}" startOffset="50%">{{ section.settings.eyebrow | escape }}</textPath>
          </text>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <text class="af__title" text-anchor="middle">
            <textPath href="#af-title-path-{{ sid }}" startOffset="50%">{{ section.settings.heading | escape }}</textPath>
          </text>
        {%- endif -%}
      </svg>
    {%- endif -%}

    <div class="af__image-wrap">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800, 1000, 1200, 1600',
          sizes: '(min-width: 1000px) 1000px, 100vw',
          alt: section.settings.image.alt | default: section.settings.heading }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>

  <div class="af__content">
    {%- if section.settings.text != blank -%}
      <div class="af__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="af__founders">
        {%- for block in section.blocks -%}
          <li class="af__founder" {{ block.shopify_attributes }}>
            <div class="af__avatar">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 300 | image_tag:
                  loading: 'lazy',
                  widths: '110, 220, 300',
                  sizes: '110px',
                  alt: block.settings.name }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            {%- if block.settings.name != blank -%}
              <p class="af__name">{{ block.settings.name }}</p>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <p class="af__role">{{ block.settings.role }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('af-{{ sid }}');
    if (!root) return;
    function fit() {
      var svg = root.querySelector('.af__arc');
      if (!svg) return;
      svg.querySelectorAll('text').forEach(function (t) {
        var tp = t.querySelector('textPath');
        if (!tp) return;
        var path = svg.querySelector(tp.getAttribute('href'));
        if (!path) return;
        t.style.fontSize = '';
        var base = parseFloat(getComputedStyle(t).fontSize) || 40;
        var max = path.getTotalLength() * 0.9;
        var len = (tp.getComputedTextLength && tp.getComputedTextLength()) || t.getComputedTextLength();
        if (len > max) t.style.fontSize = (base * max / len) + 'px';
      });
    }
    fit();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    window.addEventListener('load', fit);
  })();
</script>

{% schema %}
{
  "name": "About – Founders",
  "tag": "section",
  "class": "section-about-founders",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text (upar)",
      "default": "We're here for"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading (curved)",
      "info": "Lamba text apne aap chhota hokar curve me fit ho jayega",
      "default": "Simply Great Coffee"
    },
    {
      "type": "range",
      "id": "heading_width",
      "label": "Heading width (curve ki lambai)",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 800,
      "info": "Heading badi karni ho ya zyada words ho to width badhao"
    },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image (transparent PNG/WebP best rahega)"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image max width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Three good friends. One ambitious vision. We started Sleepy Owl to bring real good coffee to everyone, without complex equipment or brewing techniques.</p>"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Beech wale founder ko neeche offset karo (desktop)",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "top_bg",
      "label": "Upar ka background",
      "default": "#f7f8fb"
    },
    {
      "type": "color",
      "id": "bottom_bg",
      "label": "Neeche ka background",
      "default": "#e2e9f6"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Upar ka chhota text color (We're here for)",
      "default": "#2a3a7c"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Main heading color",
      "default": "#2a3a7c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Neeche ke description text ka color",
      "default": "#2a3a7c"
    },
    {
      "type": "color",
      "id": "founder_color",
      "label": "Founder name & role color",
      "default": "#2a3a7c"
    },
    {
      "type": "range",
      "id": "split",
      "label": "Background split position",
      "min": 20,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 62,
      "info": "Kahan se background color badalta hai (hero area me)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "rem",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Arman Sood"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Co-Founder"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About – Founders",
      "blocks": [
        { "type": "founder", "settings": { "name": "Arman Sood", "role": "Co-Founder" } },
        { "type": "founder", "settings": { "name": "Ajai Thandi", "role": "Co-Founder" } },
        { "type": "founder", "settings": { "name": "Ashwajeet Singh", "role": "Co-Founder" } }
      ]
    }
  ]
}
{% endschema %}
