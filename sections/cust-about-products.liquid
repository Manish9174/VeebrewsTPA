{%- comment -%}
  Section: About – Known For (Product grid card)
  File name: sections/about-products.liquid
{%- endcomment -%}



{%- liquid
  assign sid = section.id
-%}

<style>
  #ap-{{ sid }} {
    --ap-outer: {{ section.settings.outer_bg }};
    --ap-card: {{ section.settings.card_bg }};
    --ap-heading: {{ section.settings.heading_color }};
    --ap-desc: {{ section.settings.desc_color }};
    --ap-title: {{ section.settings.title_color }};
    --ap-text: {{ section.settings.item_text_color }};
    --ap-link: {{ section.settings.link_color }};
    --ap-cols: {{ section.settings.columns }};
    background: var(--ap-outer);
    padding: {{ section.settings.outer_padding_top }}px 20px {{ section.settings.outer_padding_bottom }}px;
    font-family: 'Lineal';
    box-sizing: border-box;
  }

  #ap-{{ sid }} *,
  #ap-{{ sid }} *::before,
  #ap-{{ sid }} *::after { box-sizing: border-box; }

  #ap-{{ sid }} .ap__card {
    max-width: {{ section.settings.card_max_width }}px;
    margin: 0 auto;
    background: var(--ap-card);
    border-radius: {{ section.settings.radius }}px;
    padding: {{ section.settings.card_padding_y }}px 40px;
  }

  #ap-{{ sid }} .ap__head {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }

  #ap-{{ sid }} .ap__heading {
    margin: 0;
    font-size: 48px;
    line-height: 1.25;
    font-weight: 300;
    color: var(--ap-heading);
  }

  #ap-{{ sid }} .ap__desc {
    margin: 28px 0 0;
    font-size: 20px;
    line-height: 1.75;
    font-weight: 400;
    color: var(--ap-desc);
  }

  #ap-{{ sid }} .ap__desc p { margin: 0; }

  #ap-{{ sid }} .ap__grid {
    list-style: none;
    margin: 90px auto 0;
    padding: 0;
    max-width: 1280px;
    display: grid;
    grid-template-columns: repeat(var(--ap-cols), minmax(0, 1fr));
    gap: 80px 40px;
  }

  #ap-{{ sid }} .ap__item {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  #ap-{{ sid }} .ap__media {
    flex: 0 0 38%;
    max-width: 160px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #ap-{{ sid }} .ap__media img,
  #ap-{{ sid }} .ap__media svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #ap-{{ sid }} .ap__body { min-width: 0; flex: 1 1 auto; }

  #ap-{{ sid }} .ap__title {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .2px;
    text-transform: uppercase;
    color: var(--ap-title);
  }

  #ap-{{ sid }} .ap__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    font-weight: 400;
    color: var(--ap-text);
  }

  #ap-{{ sid }} .ap__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ap-link);
    transition: opacity .2s ease;
  }

  #ap-{{ sid }} .ap__link svg {
    width: 11px;
    height: 11px;
    transition: transform .2s ease;
  }

  #ap-{{ sid }} .ap__link:hover { opacity: .75; }
  #ap-{{ sid }} .ap__link:hover svg { transform: translate(2px, -2px); }
  #ap-{{ sid }} .ap__link:focus-visible { outline: 2px solid var(--ap-title); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    #ap-{{ sid }} .ap__link,
    #ap-{{ sid }} .ap__link svg { transition: none; }
  }

  /* Laptop / small desktop */
  @media (max-width: 1199px) {
    #ap-{{ sid }} .ap__card { padding-left: 28px; padding-right: 28px; }
    #ap-{{ sid }} .ap__grid { gap: 60px 28px; }
    #ap-{{ sid }} .ap__item { gap: 18px; }
    #ap-{{ sid }} .ap__heading { font-size: 42px; }
  }

  /* Tablet: 2 columns */
  @media (max-width: 989px) {


    #ap-template--26182081577244__cust_about_products_8UAiVT{
    
    padding-bottom:65px;
    
    }

    #ap-{{ sid }} { --ap-cols: 2; }
    #ap-{{ sid }} .ap__grid { margin-top: 60px; gap: 50px 30px; }
    #ap-{{ sid }} .ap__heading { font-size: 38px; }
    #ap-{{ sid }} .ap__desc { font-size: 18px; margin-top: 22px; }
  }

  /* Mobile: 1 column */
  @media (max-width: 599px) {
    #ap-{{ sid }} { --ap-cols: 1; padding-left: 12px; padding-right: 12px; }
    #ap-{{ sid }} .ap__card {
      border-radius: {{ section.settings.radius | times: 0.6 | round }}px;
      padding: {{ section.settings.card_padding_y | times: 0.55 | round }}px 20px;
    }
    #ap-{{ sid }} .ap__heading { font-size: 30px; }
    #ap-{{ sid }} .ap__desc { font-size: 16px; line-height: 1.65; margin-top: 18px; }
    #ap-{{ sid }} .ap__grid { margin-top: 40px; gap: 36px; }
    #ap-{{ sid }} .ap__media { flex-basis: 34%; max-width: 120px; }
    #ap-{{ sid }} .ap__text { font-size: 15px; }
  }



  




  /* ===== Hover: product image left taraf jhukegi ===== */
  #ap-{{ sid }} .ap__media img,
  #ap-{{ sid }} .ap__media svg {
    transform-origin: 50% 90%;
    transition: transform .5s cubic-bezier(.34, 1.56, .64, 1);
    will-change: transform;
  }

  @media (hover: hover) {
    #ap-{{ sid }} .ap__item:hover .ap__media img,
    #ap-{{ sid }} .ap__item:hover .ap__media svg {
      transform: rotate(8deg) translateX(-6px) scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ap-{{ sid }} .ap__media img,
    #ap-{{ sid }} .ap__media svg { transition: none; }
    #ap-{{ sid }} .ap__item:hover .ap__media img,
    #ap-{{ sid }} .ap__item:hover .ap__media svg { transform: none; }
  }


</style>

<section id="ap-{{ sid }}" class="ap" data-section-id="{{ sid }}">
  <div class="ap__card">

    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="ap__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ap__heading">{{ section.settings.heading | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="ap__desc">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="ap__grid">
        {%- for block in section.blocks -%}
          <li class="ap__item" {{ block.shopify_attributes }}>
            <div class="ap__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 400 | image_tag:
                  loading: 'lazy',
                  widths: '120, 200, 300, 400',
                  sizes: '(min-width: 990px) 160px, 120px',
                  alt: block.settings.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="ap__body">
              {%- if block.settings.title != blank -%}
                <h3 class="ap__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="ap__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                <a class="ap__link" href="{{ block.settings.link }}">
                  {{ block.settings.link_label }}
                  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                    <path d="M2 10L10 2M4 2h6v6"/>
                  </svg>
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</section>

