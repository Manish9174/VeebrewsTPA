{% comment %}
  ============================================================
  HUCK STYLE "LET'S BE PEN PALS" NEWSLETTER SECTION
  (sections/hckx-penpals.liquid)
  ------------------------------------------------------------
  File needed: assets/cust-newsletter.css
  ------------------------------------------------------------
  NOTE: Saare classes/ids "hckxpp-" prefix se unique hain.
  ------------------------------------------------------------
  V2 - SCROLL-JACK HAND SVG
  V3 - HANDS ENABLE/DISABLE (show_hands checkbox)
  V4 - RIGHT SIDE IMAGE (image picker, width, ratio, radius,
       mobile show/hide)
  ============================================================
{% endcomment %}

{{ 'cust-newsletter.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 0;
    --hckxpp-bg: {{ s.background_color }};
    --hckxpp-text: {{ s.text_color }};
    --hckxpp-accent: {{ s.accent_color }};
    --hckxpp-min-height: {{ s.min_height }}px;
    --hckxpp-hand-angle: {{ s.hand_angle }}deg;
    --hckxpp-hands-width: {{ s.hands_width }}px;
    --hckxpp-hands-max-offset: {{ s.hands_max_offset }}%;
    --hckxpp-scroll-room: {{ s.scroll_room }}px;
    --hckxpp-img-width: {{ s.image_width }}%;
    --hckxpp-img-ratio: {{ s.image_ratio }};
    --hckxpp-img-radius: {{ s.image_radius }}px;
  }
{% endstyle %}

<section
  class="hckxpp{% unless s.show_hands %} hckxpp--no-hands{% endunless %}{% if s.image != blank %} hckxpp--has-image{% endif %}{% unless s.show_image_mobile %} hckxpp--hide-img-mobile{% endunless %}"
  id="hckxpp-{{ section.id }}"
  data-hckxpp
  data-hands-max-offset="{{ s.hands_max_offset }}"
>
  {%- comment -%} Tall spacer = scroll "room" jitni der tak section lock rahega {%- endcomment -%}
  <div class="hckxpp-scrolljack-space" data-hckxpp-space>
    <div class="hckxpp-sticky-stage">
      <div class="hckxpp-inner">
        <div class="hckxpp-copy">
          {%- if s.heading != blank -%}
            <h2 class="hckxpp-heading">{{ s.heading }}</h2>
          {%- endif -%}
          <div class="hckxpp-frm-parg">
            {%- if s.paragraph != blank -%}
              <div class="hckxpp-paragraph">{{ s.paragraph }}</div>
            {%- endif -%}

            {%- assign hckxpp_form_id = 'hckxpp-form-' | append: section.id -%}
            {% form 'customer', id: hckxpp_form_id, class: 'hckxpp-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">

              <div class="hckxpp-form-row">
                <input
                  type="email"
                  name="contact[email]"
                  id="hckxpp-email-{{ section.id }}"
                  class="hckxpp-input"
                  placeholder="{{ s.input_placeholder | default: 'Enter your email' }}"
                  required
                  {% if form.errors %}value="{{ form.email }}"{% endif %}
                >
                <button type="submit" class="hckxpp-submit">{{ s.button_text | default: 'Sign Up' }}</button>
              </div>

              {%- if s.disclaimer != blank -%}
                <div class="hckxpp-disclaimer">{{ s.disclaimer }}</div>
              {%- endif -%}

              {%- if form.posted_successfully? -%}
                <p class="hckxpp-message hckxpp-message-success">{{ s.success_message | default: "Thanks - you're on the list!" }}</p>
              {%- endif -%}

              {%- if form.errors -%}
                <p class="hckxpp-message hckxpp-message-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- endif -%}
            {% endform %}
          </div>
        </div>

        {%- comment -%} Right side image (optional) {%- endcomment -%}
        {%- if s.image != blank -%}
          <div class="hckxpp-media">
            {{ s.image | image_url: width: 1200 | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1200',
              sizes: '(min-width: 901px) 35vw, 90vw',
              class: 'hckxpp-media-img',
              alt: s.image.alt | default: s.heading }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}
        Single SVG, do <g> groups. Pehla group (pink/yellow) neeche-left
        se, doosra group (yellow/purple) upar-right se aata hai. Poora
        wrapper hi rotate hota hai taaki diagonal reach ka angle bane;
        andar groups sirf translateX karte hain (reference jaisa).
        Ye poora block show_hands checkbox se control hota hai.
      {%- endcomment -%}
      {%- if s.show_hands -%}
      <div class="hckxpp-hands-wrap" aria-hidden="true" data-hckxpp-hands>
        <svg class="hckxpp-hands-svg" viewBox="0 0 1000 204.483" xmlns="http://www.w3.org/2000/svg">
