<script>
  (function () {
    var root = document.getElementById('hckxpp-{{ section.id }}');
    if (!root) return;

    /* Hands OFF (checkbox uncheck): scroll animation ki zarurat nahi */
    if (root.classList.contains('hckxpp--no-hands')) return;

    var spacer = root.querySelector('[data-hckxpp-space]');
    if (!spacer) return;

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      /* Reduced motion: koi scroll-jack nahi, hands seedhe mile hue (final) dikhein */
      root.style.setProperty('--hckxpp-hands-offset', '0%');
      return;
    }

    var maxOffset = parseFloat(root.getAttribute('data-hands-max-offset'));
    if (isNaN(maxOffset)) maxOffset = 55;

    var ticking = false;

    function clamp(v, min, max) {
      return Math.max(min, Math.min(max, v));
    }

    function apply() {
      ticking = false;

      var rect = spacer.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var total = rect.height - vh;

      if (total <= 0) {
        root.style.setProperty('--hckxpp-hands-offset', '0%');
        return;
      }

      /* -rect.top = kitna scroll ho chuka hai spacer ke andar */
      var scrolled = clamp(-rect.top, 0, total);
      var progress = scrolled / total; // 0 = spacer abhi shuru hua, 1 = spacer khatam (hands mil chuke)

      /* Ease-out taaki milna thoda smooth lage */
      var eased = 1 - Math.pow(1 - progress, 2);

      var offset = (1 - eased) * maxOffset;
      root.style.setProperty('--hckxpp-hands-offset', offset + '%');
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    apply();
  })();
</script>

{% schema %}
{
  "name": "Custom Newsletter",
  "class": "m-section-hckxpp",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's Be Pen Pals" },
    { "type": "richtext", "id": "paragraph", "label": "Paragraph", "default": "<p>We won't flood your inbox, we promise. We're just sending the good stuff. New roasts, cafe news, and the occasional reason to treat yourself.</p><p>Sign up and get 15% off your first order.</p>" },
    { "type": "text", "id": "input_placeholder", "label": "Email input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Sign Up" },
    { "type": "richtext", "id": "disclaimer", "label": "Disclaimer text (below the form)", "default": "<p>By subscribing you agree with our Privacy Policy</p>" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks - you're on the list!" },

    { "type": "header", "content": "Right side image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "image_width", "min": 20, "max": 50, "step": 1, "unit": "%", "label": "Image width", "default": 35 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "auto", "label": "Original" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Tall (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ],
      "default": "4 / 5"
    },
    { "type": "range", "id": "image_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Image corner radius", "default": 10 },
    { "type": "checkbox", "id": "show_image_mobile", "label": "Show image on mobile", "default": true },

    { "type": "header", "content": "Hands scroll animation" },
    { "type": "checkbox", "id": "show_hands", "label": "Show hands graphic (SVG + scroll animation)", "default": true, "info": "Off karne par SVG hide hoga aur scroll-lock bhi band ho jayega" },
    { "type": "range", "id": "hands_max_offset", "min": 20, "max": 100, "step": 5, "unit": "%", "label": "Shuru me hands kitni door hon", "default": 55, "info": "Section shuru hote hi hands itni door se aana start karenge, scroll ke saath 0% (mil jaayenge) tak aayenge" },
    { "type": "range", "id": "hand_angle", "min": -70, "max": 0, "step": 1, "unit": "deg", "label": "Hands ka diagonal angle", "default": -38, "info": "Reference jaisa top-right se bottom-left waala angle set karne ke liye" },
    { "type": "range", "id": "hands_width", "min": 500, "max": 1400, "step": 20, "unit": "px", "label": "Hands graphic ki width", "default": 900 },
    { "type": "range", "id": "scroll_room", "min": 300, "max": 1600, "step": 50, "unit": "px", "label": "Scroll-lock duration", "default": 700, "info": "Jitna zyada, utni der tak scroll section par 'locked' rahega jab tak hands mil na jaayein" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "min_height", "min": 400, "max": 900, "step": 20, "unit": "px", "label": "Minimum stage height", "default": 620 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "accent_color", "label": "Button / accent color", "default": "#111111" }
  ],
  "presets": [
    {
      "name": "Custom Newsletter"
    }
  ]
}
