{% comment %}
  ============================================================
  HUCK STYLE BLEND SWIPER  (sections/hckx-blend-swiper.liquid)
  ------------------------------------------------------------
  File needed: assets/hckx-blend-swiper.css
  Uses Swiper.js (CDN) for real drag/swipe + infinite loop.
  ------------------------------------------------------------
  NOTE: Saare classes/ids "hckxbs-" prefix se unique hain.
  ------------------------------------------------------------
  METAFIELD PATHS - CODE ME HARDCODED HAIN (neeche dikh rahe hain,
  customizer me koi setting nahi hai). Agar naam badalne hain to
  seedha yahan is file me dhundo aur badlo:

    - custom.tasting_note      -> List of Metaobject references
                                   (Metaobject type: "Tasting", jiska
                                   PEHLA field display text hota hai)
    - custom.blend_description -> Rich text
    - custom.color_image       -> File reference (Image)
    - custom.border_image      -> File reference (Image)
  ------------------------------------------------------------
  BUY NOW POPUP:
    "Buy Now" ab direct add-to-cart nahi karta. Pehle ek chhota
    popup khulta hai (Price / Size / Quantity / Add to Cart).
    Subscription option abhi ke liye SKIP kiya hai (baad me add
    karna ho to .hckxbs-modal-qty-row ke baad ek naya row daalo).
  ------------------------------------------------------------
  BACKGROUND: optional image, jiske upar "Section background" color
  ka tint (opacity se control) chadhta hai - image halki dikhti hai.
  ============================================================
{% endcomment %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>
{{ 'cust-featured.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --hckxbs-bg: {{ s.background_color }};
    --hckxbs-text: {{ s.text_color }};
    --hckxbs-card-bg: {{ s.card_background }};
    --hckxbs-accent-fallback: {{ s.accent_fallback_color }};
    --hckxbs-card-width: {{ s.card_width }}px;
    --hckxbs-card-gap: {{ s.card_gap }}px;
    --hckxbs-center-image-width: {{ s.center_image_width }}px;
    --hckxbs-stage-height: {{ s.stage_height }}px;
    --hckxbs-active-left-pad: {{ s.active_left_padding | default: 150 }}px;
    --hckxbs-overlay-opacity: {{ s.overlay_opacity | default: 65 }}%;
    {% if s.background_image != blank %}
      --hckxbs-bg-image: url('{{ s.background_image | image_url: width: 1600 }}');
    {% else %}
      --hckxbs-bg-image: none;
    {% endif %}
  }
{% endstyle %}

<div
  class="hckxbs"
  id="hckxbs-{{ section.id }}"
  data-hckxbs
  data-autoplay="{{ s.autoplay | default: false }}"
  data-autoplay-speed="{{ s.autoplay_speed | default: 4 }}"
  data-currency-symbol="{{ cart.currency.symbol }}"
>
  {%- if s.heading != blank -%}
    <h2 class="hckxbs-heading">{{ s.heading }}</h2>
  {%- endif -%}

  {%- if s.paragraph != blank -%}
    <div class="hckxbs-intro">{{ s.paragraph }}</div>
  {%- endif -%}

  <div class="hckxbs-tabs" role="tablist" data-hckxbs-tabs>
    {%- for block in section.blocks -%}
      {%- if block.type == 'collection_tab' -%}
        {%- assign coll = block.settings.collection -%}
        <button
          type="button"
          class="hckxbs-tab{% if forloop.first %} is-active{% endif %}"
          data-hckxbs-tab
          data-target="hckxbs-track-{{ section.id }}-{{ forloop.index0 }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | default: coll.title | default: 'Collection' }}
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="hckxbs-stage">
    <div class="hckxbs-blob" data-hckxbs-blob aria-hidden="true">
      <img data-hckxbs-blob-img src="" alt="" width="1" height="1">
    </div>

    {%- if s.center_image != blank -%}
      <div class="hckxbs-center-image" aria-hidden="true">
        {{
          s.center_image
          | image_url: width: 700
          | image_tag: widths: '250, 375, 500, 700', alt: ''
        }}
      </div>
    {%- endif -%}

    <button type="button" class="hckxbs-arrow hckxbs-arrow-prev" data-hckxbs-prev aria-label="Previous blend">
     <svg class="_inlineSvg_57b96c0" role="none" style="--inline-svg-loaded: 1;" viewBox="0 0 34 28"><path stroke="currentColor" stroke-miterlimit="10" stroke-width="2" d="M32.962 18.794c-2.217-2.544-5.002-3.933-7.713-4.918-7.786-2.81-15.748-2.739-22.658.203"></path><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7.218 6.4c-2.045 1.933-3.652 4.579-4.635 7.681l7.182 5.958"></path></svg>
    </button>
    <button type="button" class="hckxbs-arrow hckxbs-arrow-next" data-hckxbs-next aria-label="Next blend">
      <svg class="_inlineSvg_57b96c0" role="none" style="--inline-svg-loaded: 1;" viewBox="0 0 34 28"><path stroke="currentColor" stroke-miterlimit="10" stroke-width="2" d="M32.962 18.794c-2.217-2.544-5.002-3.933-7.713-4.918-7.786-2.81-15.748-2.739-22.658.203"></path><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7.218 6.4c-2.045 1.933-3.652 4.579-4.635 7.681l7.182 5.958"></path></svg>
    </button>

    {%- for block in section.blocks -%}
      {%- if block.type == 'collection_tab' -%}
        {%- assign coll = block.settings.collection -%}
        <div
          class="hckxbs-swiper swiper{% if forloop.first %} is-active-track{% endif %}"
          data-hckxbs-track
          id="hckxbs-track-{{ section.id }}-{{ forloop.index0 }}"
        >
          <div class="swiper-wrapper">
            {%- for product in coll.products -%}
              {%- assign flavor_list = product.metafields.custom.tasting_note.value -%}
              {%- assign color_mf = product.metafields.custom.color_image.value -%}
              {%- assign border_mf = product.metafields.custom.border_image.value -%}
              {%- assign color_url = '' -%}
              {%- if color_mf != blank -%}
                {%- assign color_url = color_mf | image_url: width: 700 -%}
              {%- endif -%}

              <div class="swiper-slide">
                <div class="hckxbs-card" data-color-image="{{ color_url }}">
                  <div class="hckxbs-card-top">
                    <h3 class="hckxbs-card-title">
                      <a href="{{ product.url | within: coll }}">{{ product.title | truncate: 20 }}</a>
                    </h3>
                    {%- if color_mf != blank -%}
                      <span
                        class="hckxbs-card-blob"
                        style="background-image:url({{ color_mf | image_url: width: 200 }})"
                        aria-hidden="true"
                      ></span>
                    {%- endif -%}
                  </div>

                  <p class="hckxbs-card-flavor">

                    {%- if flavor_list -%}
                      {%- for f in flavor_list -%}
                        {{ f.name }}
                        {%- assign note_text = '' -%}
                        {%- comment -%} f ek Metaobject entry hai - uske pehle field ki value nikalte hain {%- endcomment -%}
                        {%- if f.fields.size > 0 -%}
                          {%- assign note_text = f.fields.first.value -%}
                        {%- endif -%}
                        {{ note_text }}{% unless forloop.last %} &bull; {% endunless %}
                      {%- endfor -%}
                    {%- endif -%}
                  </p>

                  <div class="hckxbs-card-desc">
                    {{ product.metafields.custom.blend_description }}
                  </div>

                  <div class="hckxbs-card-actions">
                    <a class="hckxbs-learn-more" href="{{ product.url | within: coll }}">Learn More</a>
                    {%- if product.available -%}
                      <button
                        type="button"
                        class="hckxbs-buy-now"
                        data-hckxbs-buy-now
                        data-variants="{{ product.variants | json | escape }}"
                      >Buy Now</button>
                    {%- else -%}
                      <button type="button" class="hckxbs-buy-now" disabled>Sold out</button>
                    {%- endif -%}
                  </div>

                  {%- if border_mf != blank -%}
                    <span
                      class="hckxbs-card-strip"
                      style="background-image:url({{ border_mf | image_url: width: 500 }})"
                    ></span>
                  {%- else -%}
                    <span class="hckxbs-card-strip hckxbs-card-strip-fallback"></span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Buy Now popup - single shared modal, moved to <body> on init {%- endcomment -%}
  <div class="hckxbs-modal" data-hckxbs-modal aria-hidden="true">
    <div class="hckxbs-modal-overlay" data-hckxbs-modal-close></div>
    <div class="hckxbs-modal-panel" role="dialog" aria-modal="true" aria-label="Buy now">
      <div class="hckxbs-modal-header">
        <span class="hckxbs-modal-title">Buy Now</span>
        <button type="button" class="hckxbs-modal-close" data-hckxbs-modal-close aria-label="Close"><svg class="_inlineSvg_57b96c0 _iconCart_04d7592" aria-label="Close" style="--inline-svg-loaded: 1;" viewBox="0 0 26 26">
  <path fill="currentColor" d="M9.46499 18.3026 13 14.7676l3.535 3.535 1.7675-1.7675-3.535-3.535 3.535-3.53503-1.7675-1.7675L13 11.2326 9.46499 7.69757l-1.7675 1.7675 3.53501 3.53503-3.53501 3.535 1.7675 1.7675Z"></path>
  <path fill="currentColor" d="M13 25.5c6.8925 0 12.5-5.6075 12.5-12.5S19.8925.5 13 .5.5 6.1075.5 13 6.1075 25.5 13 25.5ZM13 3c5.5138 0 10 4.48625 10 10 0 5.5138-4.4862 10-10 10-5.51375 0-10-4.4862-10-10C3 7.48625 7.48625 3 13 3Z"></path>
</svg></button>
      </div>

      <div class="hckxbs-modal-row">
        <span class="hckxbs-modal-label">Price</span>
        <span class="hckxbs-modal-price" data-hckxbs-modal-price></span>
      </div>

      <div class="hckxbs-modal-row" data-hckxbs-modal-size-row>
        <span class="hckxbs-modal-label">Size</span>
        <div class="hckxbs-modal-size-options" data-hckxbs-modal-size-options></div>
      </div>

      <div class="hckxbs-modal-row">
        <span class="hckxbs-modal-label">Quantity</span>
        <div class="hckxbs-modal-qty">
          <button type="button" class="hckxbs-modal-qty-btn" data-hckxbs-qty-minus aria-label="Decrease quantity">&minus;</button>
          <span class="hckxbs-modal-qty-value" data-hckxbs-qty-value>1</span>
          <button type="button" class="hckxbs-modal-qty-btn" data-hckxbs-qty-plus aria-label="Increase quantity">+</button>
        </div>
      </div>

      <button type="button" class="hckxbs-modal-add" data-hckxbs-modal-add>Add to Cart</button>
    </div>
  </div>
</div>

<script>
  (function () {
    function boot() {
      var root = document.getElementById('hckxbs-{{ section.id }}');
      if (!root || typeof Swiper === 'undefined') return;

      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-hckxbs-tab]'));
      var tracks = Array.prototype.slice.call(root.querySelectorAll('[data-hckxbs-track]'));
      var blobImg = root.querySelector('[data-hckxbs-blob-img]');
      var prevBtn = root.querySelector('[data-hckxbs-prev]');
      var nextBtn = root.querySelector('[data-hckxbs-next]');
      var currencySymbol = root.getAttribute('data-currency-symbol') || '$';

      var autoplayEnabled = root.getAttribute('data-autoplay') === 'true';
      var autoplaySpeed = (parseFloat(root.getAttribute('data-autoplay-speed')) || 4) * 1000;
      var activeSwiper = null;

      function updateBlob(trackEl) {
        var swiper = trackEl._hckxbsSwiper;
        if (!swiper || !blobImg) return;
        var activeSlide = swiper.slides[swiper.activeIndex];
        var card = activeSlide && activeSlide.querySelector('.hckxbs-card');
        var url = card ? card.getAttribute('data-color-image') : '';

        if (url) {
          var preload = new Image();
          preload.onload = function () {
            blobImg.style.opacity = '0';
            setTimeout(function () {
              blobImg.src = url;
              blobImg.style.opacity = '1';
            }, 150);
          };
          preload.src = url;
        } else {
          blobImg.style.opacity = '0';
        }
      }

function initTrack(trackEl) {
  if (trackEl._hckxbsSwiper) return trackEl._hckxbsSwiper;

  var slideCount = trackEl.querySelectorAll('.swiper-slide').length;

  var swiper = new Swiper(trackEl, {
    slidesPerView: 'auto',
    centeredSlides: true,

    // 3 se jyada slides hain tabhi loop
    loop: slideCount > 3,

    loopAdditionalSlides: slideCount > 3 ? 3 : 0,

    speed: 550,
    spaceBetween: {{ s.card_gap | default: 26 }},
    grabCursor: true,
    slideToClickedSlide: true,

    // Exactly 3 slides hain to middle wali slide initially center me
    initialSlide: slideCount === 3 ? 1 : 0,

    autoplay: autoplayEnabled
      ? {
          delay: autoplaySpeed,
          disableOnInteraction: false
        }
      : false,

    on: {
      slideChangeTransitionEnd: function () {
        updateBlob(trackEl);
      },

      init: function () {
        updateBlob(trackEl);
      }
    }
  });

  // 3 ya usse kam slides hain to arrows hide
  if (prevBtn && nextBtn) {
    var showArrows = slideCount > 3;

    prevBtn.style.display = showArrows ? '' : 'none';
    nextBtn.style.display = showArrows ? '' : 'none';
  }

  trackEl._hckxbsSwiper = swiper;
  return swiper;
}

      function showTrack(trackEl) {
        tracks.forEach(function (t) {
          t.classList.toggle('is-active-track', t === trackEl);
        });

        var swiper = trackEl._hckxbsSwiper;
        if (!swiper) {
          swiper = initTrack(trackEl);
        } else {
          swiper.update();
        }
        activeSwiper = swiper;
        updateBlob(trackEl);
      }

      /* ---- Tabs ---- */
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');

          var targetTrack = document.getElementById(tab.getAttribute('data-target'));
          if (targetTrack) showTrack(targetTrack);
        });
      });

      /* ---- Shared arrows control whichever track is active ---- */
      if (prevBtn) prevBtn.addEventListener('click', function () { if (activeSwiper) activeSwiper.slidePrev(); });
      if (nextBtn) nextBtn.addEventListener('click', function () { if (activeSwiper) activeSwiper.slideNext(); });

      /* -----------------------------------------------------------
         BUY NOW POPUP
         ----------------------------------------------------------- */
      var modal = root.querySelector('[data-hckxbs-modal]');
      if (modal) {
        // Move modal to <body> so it can sit above the fixed header
        // (the section deliberately keeps its own z-index low).
        document.body.appendChild(modal);
      }
      var priceEl = modal && modal.querySelector('[data-hckxbs-modal-price]');
      var sizeRow = modal && modal.querySelector('[data-hckxbs-modal-size-row]');
      var sizeOptionsEl = modal && modal.querySelector('[data-hckxbs-modal-size-options]');
      var qtyValueEl = modal && modal.querySelector('[data-hckxbs-qty-value]');
      var qtyMinusBtn = modal && modal.querySelector('[data-hckxbs-qty-minus]');
      var qtyPlusBtn = modal && modal.querySelector('[data-hckxbs-qty-plus]');
      var addBtn = modal && modal.querySelector('[data-hckxbs-modal-add]');
      var closeEls = modal ? Array.prototype.slice.call(modal.querySelectorAll('[data-hckxbs-modal-close]')) : [];

      var currentVariants = [];
      var currentVariantId = null;
      var currentQty = 1;

      function formatPrice(cents) {
        return currencySymbol + (cents / 100).toFixed(2);
      }

      function setSelectedVariant(variant) {
        currentVariantId = variant.id;
        if (priceEl) priceEl.textContent = formatPrice(variant.price);
        if (sizeOptionsEl) {
          Array.prototype.slice.call(sizeOptionsEl.querySelectorAll('[data-hckxbs-size-btn]')).forEach(function (btn) {
            btn.classList.toggle('is-active', parseInt(btn.getAttribute('data-variant-id'), 10) === variant.id);
          });
        }
      }

      function openModalForVariants(variants) {
        if (!modal || !variants || !variants.length) return;
        currentVariants = variants;
        currentQty = 1;
        if (qtyValueEl) qtyValueEl.textContent = currentQty;

        // Build size buttons (skip if only one variant / no real option)
        if (sizeOptionsEl) {
          sizeOptionsEl.innerHTML = '';
          var hasMultiple = variants.length > 1;
          if (sizeRow) sizeRow.style.display = hasMultiple ? '' : 'none';
          variants.forEach(function (variant) {
            var label = variant.option1 || variant.title;
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'hckxbs-modal-size-btn';
            btn.textContent = label;
            btn.setAttribute('data-hckxbs-size-btn', '');
            btn.setAttribute('data-variant-id', variant.id);
            if (!variant.available) btn.disabled = true;
            btn.addEventListener('click', function () { setSelectedVariant(variant); });
            sizeOptionsEl.appendChild(btn);
          });
        }

        var firstAvailable = variants.filter(function (v) { return v.available; })[0] || variants[0];
        setSelectedVariant(firstAvailable);

        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('hckxbs-modal-open');
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('hckxbs-modal-open');
      }

      closeEls.forEach(function (el) { el.addEventListener('click', closeModal); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal && modal.classList.contains('is-open')) closeModal();
      });

      if (qtyMinusBtn) {
        qtyMinusBtn.addEventListener('click', function () {
          currentQty = Math.max(1, currentQty - 1);
          if (qtyValueEl) qtyValueEl.textContent = currentQty;
        });
      }
      if (qtyPlusBtn) {
        qtyPlusBtn.addEventListener('click', function () {
          currentQty = currentQty + 1;
          if (qtyValueEl) qtyValueEl.textContent = currentQty;
        });
      }

      if (addBtn) {
        addBtn.addEventListener('click', function () {
          if (!currentVariantId || addBtn.disabled) return;
          addBtn.disabled = true;
          var originalText = addBtn.textContent;
          addBtn.textContent = 'Adding...';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: currentVariantId, quantity: currentQty }] })
          })
            .then(function (res) {
              if (!res.ok) throw new Error('add to cart failed');
              window.location.href = '/cart';
            })
            .catch(function () {
              addBtn.disabled = false;
              addBtn.textContent = originalText;
            });
        });
      }

      /* Buy Now buttons open the popup instead of adding to cart directly */
      root.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-hckxbs-buy-now]');
        if (!btn || btn.disabled) return;
        var raw = btn.getAttribute('data-variants');
        if (!raw) return;
        var variants;
        try {
          variants = JSON.parse(raw);
        } catch (err) {
          return;
        }
        openModalForVariants(variants);
      });

      /* ---- Init: first track ---- */
      if (tracks.length) showTrack(tracks[0]);

      /* Theme editor: section reload par dobara init */
      document.addEventListener('shopify:section:load', function (e) {
        if (e.target && e.target.querySelector('#hckxbs-{{ section.id }}')) {
          location.reload();
        }
      });
    }

    if (typeof Swiper !== 'undefined') {
      boot();
    } else {
      window.addEventListener('load', boot);
    }
  })();
</script>

{% schema %}
{
  "name": "Blend Swiper",
  "class": "m-section-hckxbs",
  "settings": [
    { "type": "header", "content": "Heading (optional)" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "paragraph", "label": "Paragraph" },

    { "type": "header", "content": "Center image" },
    { "type": "image_picker", "id": "center_image", "label": "Fixed center image (bag mockup)" },
    { "type": "range", "id": "center_image_width", "min": 150, "max": 500, "step": 10, "unit": "px", "label": "Center image width", "default": 260 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_width", "min": 260, "max": 460, "step": 10, "unit": "px", "label": "Card width", "default": 340 },
    { "type": "range", "id": "card_gap", "min": 10, "max": 60, "step": 2, "unit": "px", "label": "Gap between cards", "default": 26 },
    { "type": "range", "id": "stage_height", "min": 420, "max": 760, "step": 10, "unit": "px", "label": "Carousel stage height", "default": 560 },
    { "type": "range", "id": "active_left_padding", "min": 60, "max": 260, "step": 10, "unit": "px", "label": "Active card left padding", "default": 150, "info": "Fixed image se content clear rakhne ke liye" },

    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Section background image (optional)" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 65, "info": "0% = sirf image dikhegi, 100% = sirf color dikhega (image chhup jayegi). Neeche wala 'Section background' hi tint ke liye use hota hai." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F9F4EC" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "accent_fallback_color", "label": "Fallback accent color (agar product ki color image na ho)", "default": "#E6007E" },

    { "type": "header", "content": "Autoplay" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay on", "default": false },
    { "type": "range", "id": "autoplay_speed", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Autoplay speed", "default": 4 }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label override", "info": "Blank chhodoge to collection ka naam use hoga" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blend Swiper",
      "blocks": [
        { "type": "collection_tab" }
      ]
    }
  ]
}
{% endschema %}
