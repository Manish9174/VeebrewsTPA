{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign s = section.settings
  assign use_cards = false
  if s.grid_style == 'cards'
    assign use_cards = true
  endif
-%}

{%- if use_cards -%}
  {{ 'cust-featured-new.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if use_cards -%}
    #shopify-section-{{ section.id }} {
      --hckxbs-bg: {{ s.background_color }};
      --hckxbs-text: {{ s.text_color }};
      --hckxbs-card-bg: {{ s.card_background }};
      --hckxbs-accent-fallback: {{ s.accent_fallback_color }};
      --hckxbs-card-width: {{ s.card_width }}px;
      --hckxbs-card-gap: {{ s.card_gap }}px;
      --hckxbs-row-gap: {{ s.row_gap }}px;
      --hckxbs-product-img-width: {{ s.product_image_width }}px;
      --hckxbs-image-overlap: {{ s.image_overlap }}px;
      --hckxbs-overlay-opacity: {{ s.overlay_opacity }}%;
      {% if s.background_image != blank %}
        --hckxbs-bg-image: url('{{ s.background_image | image_url: width: 1600 }}');
      {% else %}
        --hckxbs-bg-image: none;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .hckxbs {
      padding-top: {{ s.grid_top_space }}px;
    }
  {%- endif -%}


  
#shopify-section-{{ section.id }} .hckxbs-item .hckxbs-card-image {
  transition: transform 0.4s ease !important;
}

#shopify-section-{{ section.id }} .hckxbs-item:hover .hckxbs-card-image {
  transform: translate(-50%, 0) rotate(8deg) scale(1.03) !important;
}

{%- endstyle -%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
      {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
        <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <h2 class="facet-filters__label caption-large text-body">
                  <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </h2>
                <div class="select">
                  {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in collection.sort_options -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </div>
              </div>
            </div>

            <div class="product-count-vertical light" role="status">
              <h2 class="product-count__text text-body">
                <span id="ProductCountDesktop">
                  {%- if collection.results_count -%}
                    {{
                      'templates.search.results_with_count'
                      | t: terms: collection.terms, count: collection.results_count
                    }}
                  {%- elsif collection.products_count == collection.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: collection.products_count, count: collection.all_products_count
                    }}
                  {%- endif -%}
                </span>
              </h2>
              {%- render 'loading-spinner' -%}
            </div>
          </form>
        </facet-filters-form>
      {%- endif -%}

      <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
        {{ 'component-facets.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            aria-labelledby="verticalTitle"
            class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
            id="main-collection-filters"
            data-id="{{ section.id }}"
          >
            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: section.settings.filter_type,
              paginate: paginate
            %}
          </aside>
        {%- endif -%}

        <div
          class="product-grid-container{% if settings.animations_reveal_on_scroll and use_cards == false %} scroll-trigger animate--slide-in{% endif %}"
          id="ProductGridContainer"
          {% if settings.animations_reveal_on_scroll and use_cards == false %}
            data-cascade
          {% endif %}
        >
          {%- if collection.products.size == 0 -%}
            <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: collection.url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div
              class="collection{% if section.settings.filter_type != 'vertical' and use_cards == false %} page-width{% endif %}"
            >
              <div class="loading-overlay gradient"></div>

              {%- if use_cards -%}
                {% render 'cust-product-grid',
                  products: collection.products,
                  collection: collection,
                  section_id: section.id
                %}
              {%- else -%}
                <ul
                  id="product-grid"
                  data-id="{{ section.id }}"
                  class="
                    grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                    grid--{{ section.settings.columns_desktop }}-col-desktop
                    {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
                  "
                >
                  {% assign skip_card_product_styles = false %}
                  {%- for product in collection.products -%}
                    {% assign lazy_load = false %}
                    {%- if forloop.index > 2 -%}
                      {%- assign lazy_load = true -%}
                    {%- endif -%}
                    <li
                      class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: section.settings.image_ratio,
                        image_shape: section.settings.image_shape,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        lazy_load: lazy_load,
                        skip_styles: skip_card_product_styles,
                        quick_add: section.settings.quick_add,
                        section_id: section.id,
                        product_view_context: 'collection'
                      %}
                    </li>
                    {%- assign skip_card_product_styles = true -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</collection-component>

{%- if use_cards -%}
  {%- comment -%} Cursor label (ek hi baar, grid ke bahar) {%- endcomment -%}
  <div class="hckxbs-cursor" id="hckxbs-cursor-{{ section.id }}" aria-hidden="true">
    <span class="hckxbs-cursor-dot"></span>
    <span class="hckxbs-cursor-text"></span>
  </div>

  {%- comment -%} Buy Now popup (ek hi baar, JS isse <body> me move karti hai) {%- endcomment -%}
  <div
    class="hckxbs-modal"
    id="hckxbs-modal-{{ section.id }}"
    data-currency-symbol="{{ cart.currency.symbol }}"
    aria-hidden="true"
  >
    <div class="hckxbs-modal-overlay" data-hckxbs-modal-close></div>
    <div class="hckxbs-modal-panel" role="dialog" aria-modal="true" aria-label="Buy now">
      <div class="hckxbs-modal-header">
        <span class="hckxbs-modal-title">Buy Now</span>
        <button type="button" class="hckxbs-modal-close" data-hckxbs-modal-close aria-label="Close"><svg aria-label="Close" viewBox="0 0 26 26" width="26" height="26">
  <path fill="currentColor" d="M9.46499 18.3026 13 14.7676l3.535 3.535 1.7675-1.7675-3.535-3.535 3.535-3.53503-1.7675-1.7675L13 11.2326 9.46499 7.69757l-1.7675 1.7675 3.53501 3.53503-3.53501 3.535 1.7675 1.7675Z"></path>
  <path fill="currentColor" d="M13 25.5c6.8925 0 12.5-5.6075 12.5-12.5S19.8925.5 13 .5.5 6.1075.5 13 6.1075 25.5 13 25.5ZM13 3c5.5138 0 10 4.48625 10 10 0 5.5138-4.4862 10-10 10-5.51375 0-10-4.4862-10-10C3 7.48625 7.48625 3 13 3Z"></path>
</svg></button>
      </div>

      <div class="hckxbs-modal-row">
        <span class="hckxbs-modal-label">Price</span>
        <span class="hckxbs-modal-price" data-hckxbs-modal-price></span>
      </div>

      <div class="hckxbs-modal-row" data-hckxbs-modal-size-row>
        <span class="hckxbs-modal-label">Size</span>
        <div class="hckxbs-modal-size-options" data-hckxbs-modal-size-options></div>
      </div>

      <div class="hckxbs-modal-row">
        <span class="hckxbs-modal-label">Quantity</span>
        <div class="hckxbs-modal-qty">
          <button type="button" class="hckxbs-modal-qty-btn" data-hckxbs-qty-minus aria-label="Decrease quantity">&minus;</button>
          <span class="hckxbs-modal-qty-value" data-hckxbs-qty-value>1</span>
          <button type="button" class="hckxbs-modal-qty-btn" data-hckxbs-qty-plus aria-label="Increase quantity">+</button>
        </div>
      </div>

      <button type="button" class="hckxbs-modal-add" data-hckxbs-modal-add>Add to Cart</button>
    </div>
  </div>

  <script>
    (function () {
      var sectionEl = document.getElementById('shopify-section-{{ section.id }}') || document;

      /* ---------------------------------------------------------
         1) BUY NOW POPUP (ek hi baar bind hota hai)
         --------------------------------------------------------- */
      var modal = document.getElementById('hckxbs-modal-{{ section.id }}');
      if (modal) {
        // Theme editor me section reload hone par purana copy hata do
        var old = document.querySelectorAll('body > #hckxbs-modal-{{ section.id }}');
        Array.prototype.slice.call(old).forEach(function (el) { el.parentNode.removeChild(el); });
        document.body.appendChild(modal);

        var currencySymbol = modal.getAttribute('data-currency-symbol') || '$';
        var priceEl = modal.querySelector('[data-hckxbs-modal-price]');
        var sizeRow = modal.querySelector('[data-hckxbs-modal-size-row]');
        var sizeOptionsEl = modal.querySelector('[data-hckxbs-modal-size-options]');
        var qtyValueEl = modal.querySelector('[data-hckxbs-qty-value]');
        var qtyMinusBtn = modal.querySelector('[data-hckxbs-qty-minus]');
        var qtyPlusBtn = modal.querySelector('[data-hckxbs-qty-plus]');
        var addBtn = modal.querySelector('[data-hckxbs-modal-add]');
        var closeEls = Array.prototype.slice.call(modal.querySelectorAll('[data-hckxbs-modal-close]'));

        var currentVariantId = null;
        var currentQty = 1;

        function formatPrice(cents) {
          return currencySymbol + (cents / 100).toFixed(2);
        }

        function setSelectedVariant(variant) {
          currentVariantId = variant.id;
          if (priceEl) priceEl.textContent = formatPrice(variant.price);
          Array.prototype.slice.call(sizeOptionsEl.querySelectorAll('[data-hckxbs-size-btn]')).forEach(function (btn) {
            btn.classList.toggle('is-active', parseInt(btn.getAttribute('data-variant-id'), 10) === variant.id);
          });
        }

        function openModal(variants) {
          if (!variants || !variants.length) return;
          currentQty = 1;
          qtyValueEl.textContent = currentQty;

          sizeOptionsEl.innerHTML = '';
          sizeRow.style.display = variants.length > 1 ? '' : 'none';
          variants.forEach(function (variant) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'hckxbs-modal-size-btn';
            btn.textContent = variant.option1 || variant.title;
            btn.setAttribute('data-hckxbs-size-btn', '');
            btn.setAttribute('data-variant-id', variant.id);
            if (!variant.available) btn.disabled = true;
            btn.addEventListener('click', function () { setSelectedVariant(variant); });
            sizeOptionsEl.appendChild(btn);
          });

          var firstAvailable = variants.filter(function (v) { return v.available; })[0] || variants[0];
          setSelectedVariant(firstAvailable);

          modal.classList.add('is-open');
          modal.setAttribute('aria-hidden', 'false');
          document.body.classList.add('hckxbs-modal-open');
        }

        function closeModal() {
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('hckxbs-modal-open');
        }

        closeEls.forEach(function (el) { el.addEventListener('click', closeModal); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
        });

        qtyMinusBtn.addEventListener('click', function () {
          currentQty = Math.max(1, currentQty - 1);
          qtyValueEl.textContent = currentQty;
        });
        qtyPlusBtn.addEventListener('click', function () {
          currentQty += 1;
          qtyValueEl.textContent = currentQty;
        });

      addBtn.addEventListener('click', function () {
  if (!currentVariantId || addBtn.disabled) return;
  addBtn.disabled = true;
  var originalText = addBtn.textContent;
  addBtn.textContent = 'Adding...';

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
    body: JSON.stringify({ items: [{ id: currentVariantId, quantity: currentQty }] })
  })
    .then(function (res) {
      if (!res.ok) throw new Error('add to cart failed');
      return res.json();
    })
    .then(function () {
      closeModal();
      addBtn.disabled = false;
      addBtn.textContent = originalText;
      // Header ka cart drawer open hoga aur latest cart load karega
      document.dispatchEvent(new CustomEvent('cart:add'));
    })
    .catch(function () {
      addBtn.disabled = false;
      addBtn.textContent = originalText;
    });
});

        // Delegation: filter/sort se grid replace hone par bhi Buy Now kaam karega
        sectionEl.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-hckxbs-buy-now]');
          if (!btn || btn.disabled) return;
          var raw = btn.getAttribute('data-variants');
          if (!raw) return;
          try {
            openModal(JSON.parse(raw));
          } catch (err) {}
        });
      }

      /* ---------------------------------------------------------
         2) CURSOR LABEL (card par hover karne se product title)
         --------------------------------------------------------- */
      var cursorEl = document.getElementById('hckxbs-cursor-{{ section.id }}');
      var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      if (cursorEl && canHover) {
        var cursorText = cursorEl.querySelector('.hckxbs-cursor-text');
        var curX = 0, curY = 0, tgtX = 0, tgtY = 0, curRaf = null, curVisible = false;

        var curLoop = function () {
          curX += (tgtX - curX) * 0.18;
          curY += (tgtY - curY) * 0.18;
          cursorEl.style.transform = 'translate3d(' + (curX + 18) + 'px,' + (curY + 18) + 'px,0)';
          curRaf = requestAnimationFrame(curLoop);
        };

        var showCursor = function () {
          if (curVisible) return;
          curVisible = true;
          cursorEl.classList.add('is-visible');
          if (!curRaf) curRaf = requestAnimationFrame(curLoop);
        };

        var hideCursor = function () {
          if (!curVisible) return;
          curVisible = false;
          cursorEl.classList.remove('is-visible');
          cancelAnimationFrame(curRaf);
          curRaf = null;
        };

        sectionEl.addEventListener('mousemove', function (e) {
          var item = e.target.closest('.hckxbs-item');
          var overUi = e.target.closest('a, button');

          if (item && !overUi) {
            var card = item.querySelector('.hckxbs-card');
            var title = card ? card.getAttribute('data-title') : '';
            if (!title) { hideCursor(); return; }

            if (cursorText.textContent !== title) cursorText.textContent = title;
            tgtX = e.clientX;
            tgtY = e.clientY;
            if (!curVisible) { curX = tgtX; curY = tgtY; }
            showCursor();
          } else {
            hideCursor();
          }
        });

        sectionEl.addEventListener('mouseleave', hideCursor);
        window.addEventListener('scroll', hideCursor, { passive: true });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Grid style"
    },
    {
      "type": "select",
      "id": "grid_style",
      "label": "Product grid style",
      "info": "Cards style me products featured collection jaise cards me dikhenge (ek row me 3, slider nahi).",
      "options": [
        { "value": "default", "label": "Default (Dawn grid)" },
        { "value": "cards", "label": "Cards grid (custom, 3 per row)" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label",
      "visible_if": "{{ section.settings.grid_style == 'default' }}"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ],
      "visible_if": "{{ section.settings.grid_style == 'default' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content",
      "visible_if": "{{ section.settings.grid_style == 'default' }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label",
      "visible_if": "{{ section.settings.grid_style == 'default' }}"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        { "value": "default", "label": "t:sections.all.image_shape.options__1.label" },
        { "value": "arch", "label": "t:sections.all.image_shape.options__2.label" },
        { "value": "blob", "label": "t:sections.all.image_shape.options__3.label" },
        { "value": "chevronleft", "label": "t:sections.all.image_shape.options__4.label" },
        { "value": "chevronright", "label": "t:sections.all.image_shape.options__5.label" },
        { "value": "diamond", "label": "t:sections.all.image_shape.options__6.label" },
        { "value": "parallelogram", "label": "t:sections.all.image_shape.options__7.label" },
        { "value": "round", "label": "t:sections.all.image_shape.options__8.label" }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label",
      "visible_if": "{{ section.settings.grid_style == 'default' }}"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label",
      "visible_if": "{{ section.settings.grid_style == 'default' }}"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label",
      "visible_if": "{{ section.settings.grid_style == 'default' }}"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info",
