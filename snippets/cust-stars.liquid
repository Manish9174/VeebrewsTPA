{%- comment -%}
  snippets/kyb-stars.liquid
  Usage: {% render 'kyb-stars', score: 2.5 %}   (0 to 3, half steps allowed)
{%- endcomment -%}
{%- capture star_points -%}12,1 14.68,5.53 19.78,4.22 18.47,9.32 23,12 18.47,14.68 19.78,19.78 14.68,18.47 12,23 9.32,18.47 4.22,19.78 5.53,14.68 1,12 5.53,9.32 4.22,4.22 9.32,5.53{%- endcapture -%}
<div class="kyb__stars" role="img" aria-label="{{ score }} out of 3">
  {%- for i in (1..3) -%}
    {%- assign half_point = i | minus: 0.5 -%}
    {%- if score >= i -%}{%- assign w = 100 -%}
    {%- elsif score >= half_point -%}{%- assign w = 50 -%}
    {%- else -%}{%- assign w = 0 -%}{%- endif -%}
    <span class="kyb__star">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="{{ star_points }}" fill="none" stroke="var(--kyb-ink)" stroke-width="1" stroke-dasharray="2 1.5"/></svg>
      <span class="fill" style="width:{{ w }}%"><svg viewBox="0 0 24 24" style="width:22px;height:22px" aria-hidden="true"><polygon points="{{ star_points }}" fill="var(--kyb-ink)"/></svg></span>
    </span>
  {%- endfor -%}
</div>
